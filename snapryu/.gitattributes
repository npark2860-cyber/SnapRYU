dist/languages/* linguist-vendored
dist/qt_themes/* linguist-vendored
externals/* linguist-vendored
*.h linguist-language=cpp

# Windows self-hosted E5 rewrites these two checkout-only source files with CRLF.
# Treat CR at EOL as part of the line ending so git diff --check validates real whitespace only.
src/core/arm/nce/arm_nce_windows.cpp whitespace=cr-at-eol
src/core/arm/nce/windows_nce_transition.cpp whitespace=cr-at-eol
