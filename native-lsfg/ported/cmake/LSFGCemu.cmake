include_guard(GLOBAL)
get_filename_component(_LSFG_CEMU_SOURCE "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT TARGET LSFGCemu::LSFGCemu)
  add_subdirectory("${_LSFG_CEMU_SOURCE}" "${CMAKE_CURRENT_BINARY_DIR}/lsfg-cemu-arm64")
endif()
function(lsfg_cemu_attach host_target)
  if(NOT TARGET "${host_target}")
    message(FATAL_ERROR "Create the Cemu host target before lsfg_cemu_attach()")
  endif()
  target_link_libraries("${host_target}" PRIVATE LSFGCemu::LSFGCemu)
endfunction()
