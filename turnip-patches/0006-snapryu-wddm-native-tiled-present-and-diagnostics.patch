+   fflush(s->log);
+   s->submits = s->submit_ns = s->submit_max_ns = s->gap_max_ns = 0;
+   s->waits = s->signals = 0;
+   s->retire_calls = s->retire_ns = s->retire_max_ns = s->retire_len_max = s->retire_freed = 0;
+   s->rp_sysmem = s->rp_gmem = s->rp_flips = 0;
