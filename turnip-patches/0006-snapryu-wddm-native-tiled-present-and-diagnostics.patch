+static VkResult
+wddm_native_import(VkDevice device, void *resource,
+                              const VkMemoryAllocateInfo *info, const VkAllocationCallbacks *alloc,
+                              VkDeviceMemory *out)
+{
+   *out = VK_NULL_HANDLE;
